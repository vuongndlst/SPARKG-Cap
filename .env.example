# OpenAI API configuration (Primary generator backend)
OPENAI_API_KEY=your_openai_api_key_here
# Optional comma-separated key pool for concurrent evaluation:
# OPENAI_API_KEYS=key1,key2,key3
OPENAI_MODEL=gpt-4o-mini
MAX_CONCURRENT=10

# Optional local Qwen backend configuration (--backend qwen)
QWEN_MODEL=Qwen/Qwen2.5-14B-Instruct

# Optional Neo4j connection (for Phase 3 property-graph indexing)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
